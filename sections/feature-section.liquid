<div class="feature-section">
  <div class="feature-section__container">
    <div class="feature-section__content">
      <h2 class="feature-section__title">{{ section.settings.title }}</h2>
    </div>
  </div>
</div>

{% for block in section.blocks %}
  <div class="feature-section__block">
    <div class="feature-section__block-content">
      <div class="feature-section__block-content-text">
        {{ block.settings.number }}
      </div>
    </div>
  </div>
{% endfor %}

{% schema %}
{
  "name": "Feature Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    }
  ],
  "blocks": [
    {
      "type": "numbers",
      "name": "Numbers",
      "settings": [
        {
          "type": "number",
          "id": "number",
          "label": "Number"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Section"
    }
  ]
}
{% endschema %}
